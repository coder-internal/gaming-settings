# Postgres connection strings from the Neon integration in Vercel.
# DATABASE_URL is the pooled connection (used at runtime).
# DATABASE_URL_UNPOOLED is the direct connection (used for migrations).
# See docs/ENVIRONMENT.md for the full list of vars Neon provides.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Shared passcode gate for this single-user app.
APP_PASSCODE="change-me"

# Phase 2, not required yet:
# STEAM_API_KEY="..."
# STEAM_ID="..."
